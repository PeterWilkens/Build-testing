<?xml version="1.0" encoding="utf-8"?>
<section xml:id="sec-extended-grid-practice" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Extended Grid Practice</title>
  <p>Use these extended grids to practice locating notes and building shapes across the full 55-node layout.</p>
  <pagebreak/>
  <figure xml:id="fig-extended-grid-practice-page">
    <caption>Extended grid practice page.</caption>
    <sbsgroup>
      <sidebyside widths="31% 31% 31%" margins="2%">
        <image xml:id="img-extended-grid-practice-1">
          <latex-image>
\begin{tikzpicture}[scale=0.30, transform shape]
\pgfmathsetmacro{\isoangle}{60}
\pgfmathsetmacro{\vv}{11}
\pgfmathsetmacro{\hh}{6}
\pgfmathsetmacro{\vlen}{0.85}
\pgfmathsetmacro{\ang}{\isoangle/2}
\pgfmathsetmacro{\dlen}{(\vlen/2) / sin(\ang)}
\pgfmathsetmacro{\hlen}{(\vlen/2) / tan(\ang)}
\pgfmathsetmacro{\xmax}{\hh*\hlen}
\pgfmathsetmacro{\ymax}{\vv*\vlen}
\drawgridandnotes
\extendedgridnotes
\end{tikzpicture}
          </latex-image>
        </image>
