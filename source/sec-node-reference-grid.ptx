<?xml version="1.0" encoding="utf-8"?>
<section xml:id="sec-node-reference-grid" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Node Reference Grid (1–30)</title>

  <p>
    The grid below numbers every node from <m>1</m> (lowest C, bottom-right) to
    <m>30</m> (highest G, top-left). Each diagonal band of five nodes rises from
    col 5 (right) to col 1 (left). To request a chord shape, simply name the
    node numbers to highlight — for example <q>nodes 1, 7, 12</q> gives the C
    major triad (C, E, G).
  </p>

  <figure xml:id="fig-node-reference">
    <caption>Node numbering reference — node 1 is the lowest C (bottom-right);
    node 30 is the highest G (top-left).</caption>
    <image xml:id="img-node-reference" width="40%">
      <latex-image>
\begin{tikzpicture}[scale=0.65, transform shape]
\pgfmathsetmacro{\isoangle}{60}
\pgfmathsetmacro{\vv}{8}
\pgfmathsetmacro{\hh}{6}
\pgfmathsetmacro{\vlen}{0.85}
\pgfmathsetmacro{\ang}{\isoangle/2}
\pgfmathsetmacro{\dlen}{(\vlen/2) / sin(\ang)}
\pgfmathsetmacro{\hlen}{(\vlen/2) / tan(\ang)}
\pgfmathsetmacro{\xmax}{\hh*\hlen}
\pgfmathsetmacro{\ymax}{\vv*\vlen}
\drawgridandnotes
\node[font=\small\bfseries] at ({\xmax/2},{9.3*\vlen}) {Node Reference};
% Band 1 (nodes 1-5): C to E
\gn{5}{1.5}{1}{0}
\gn{4}{2}{2}{0}
\gn{3}{2.5}{3}{0}
\gn{2}{3}{4}{0}
\gn{1}{3.5}{5}{0}
% Band 2 (nodes 6-10): Eb to G
\gn{5}{2.5}{6}{0}
\gn{4}{3}{7}{0}
\gn{3}{3.5}{8}{0}
\gn{2}{4}{9}{0}
\gn{1}{4.5}{10}{0}
% Band 3 (nodes 11-15): Gb to Bb
\gn{5}{3.5}{11}{0}
\gn{4}{4}{12}{0}
\gn{3}{4.5}{13}{0}
\gn{2}{5}{14}{0}
\gn{1}{5.5}{15}{0}
% Band 4 (nodes 16-20): A to C#
\gn{5}{4.5}{16}{0}
\gn{4}{5}{17}{0}
\gn{3}{5.5}{18}{0}
\gn{2}{6}{19}{0}
\gn{1}{6.5}{20}{0}
% Band 5 (nodes 21-25): C to E
\gn{5}{5.5}{21}{0}
\gn{4}{6}{22}{0}
\gn{3}{6.5}{23}{0}
\gn{2}{7}{24}{0}
\gn{1}{7.5}{25}{0}
% Band 6 (nodes 26-30): Eb to G
\gn{5}{6.5}{26}{0}
\gn{4}{7}{27}{0}
\gn{3}{7.5}{28}{0}
\gn{2}{8}{29}{0}
\gn{1}{8.5}{30}{0}
\end{tikzpicture}
      </latex-image>
    </image>
  </figure>

  <p>
    Full lookup table — node number, note name, and
    <c>\gn</c> address (<c>col</c>, <c>row</c>):
  </p>

  <tabular halign="center" top="minor" bottom="minor" left="minor" right="minor">
    <col right="minor"/><col right="minor"/><col right="minor"/><col right="major"/>
    <col right="minor"/><col right="minor"/><col right="minor"/><col/>
    <row header="yes" bottom="medium">
      <cell>Node</cell><cell>Note</cell><cell>col</cell><cell>row</cell>
      <cell>Node</cell><cell>Note</cell><cell>col</cell><cell>row</cell>
    </row>
    <row><cell>1</cell> <cell>C</cell>          <cell>5</cell><cell>1.5</cell>
         <cell>16</cell><cell>A</cell>           <cell>5</cell><cell>4.5</cell></row>
    <row><cell>2</cell> <cell>C&#x266F;/D&#x266D;</cell><cell>4</cell><cell>2</cell>
