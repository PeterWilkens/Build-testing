<?xml version="1.0" encoding="utf-8"?>
<section xml:id="sec-chord-progression-template" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Extended Chord Progression Template</title>

  <p>
    This template uses the shared 52-node extended 11-row grid layout, including
    the added lower and upper extension nodes.
  </p>

  <!-- ===== Row 1: Shapes 1-4 ===== -->
  <figure xml:id="fig-chord-prog-tpl-r1">
    <sidebyside widths="22% 22% 22% 22%" margins="3%">

      <image xml:id="img-chord-prog-tpl-r1-g1-52">
        <latex-image>
\begin{tikzpicture}[scale=0.58, transform shape]
\pgfmathsetmacro{\isoangle}{60}
\pgfmathsetmacro{\vv}{11}
\pgfmathsetmacro{\hh}{6}
\pgfmathsetmacro{\vlen}{0.85}
\pgfmathsetmacro{\ang}{\isoangle/2}
\pgfmathsetmacro{\dlen}{(\vlen/2) / sin(\ang)}
\pgfmathsetmacro{\hlen}{(\vlen/2) / tan(\ang)}
\pgfmathsetmacro{\xmax}{\hh*\hlen}
\pgfmathsetmacro{\ymax}{\vv*\vlen}
\drawgridandnotes
\node[font=\small\bfseries] at ({\xmax/2},{11.3*\vlen}) {Shape 1};
\extendedgridnotes
\end{tikzpicture}
        </latex-image>
      </image>

      <image xml:id="img-chord-prog-tpl-r1-g2-52">
