  <!-- macros for defining latex math shortcuts. It is good practice -->
  <!-- to define these semantically, so that the macro relates to what-->
  <!-- it defines. -->
  <macros> \newcommand{\N}{\mathbb N} \newcommand{\Z}{\mathbb Z} \newcommand{\Q}{\mathbb Q} \newcommand{\R}{\mathbb R} </macros>

  <!-- If you put any latex-image elements you can include preambles -->
  <!-- for those in the next element. -->
  <latex-image-preamble> \usepackage{tikz, pgfplots, musixtex, adjustbox} \usetikzlibrary{positioning,matrix,arrows} \usetikzlibrary{shapes,decorations,shadows,fadings,patterns} \usetikzlibrary{decorations.markings} % define a shortcut for sharp notes in tikz pictures
\renewcommand{\sh}{\#}
\newif\ifisoGridVisible \isoGridVisiblefalse
\newcommand{\drawgridandnotes}{%
  \ifisoGridVisible%
  \begin{scope}%
    \path[clip] (0,0) rectangle (\xmax,\ymax);%
    \pgfmathsetmacro{\gridii}{\hh-1}%
    \foreach \gi in {1,...,\gridii} { \draw[lightgray,very thin] (\gi*\hlen,0) -- ++(0,\ymax); }%
    \pgfmathsetmacro{\griddvlen}{2*\vv*\dlen}%
    \foreach \gi in {0,2,...,\hh} {%
      \draw[lightgray,very thin] (\gi*\hlen,0) -- ++(\ang:\griddvlen);%
      \draw[lightgray,very thin] (\gi*\hlen,\ymax) -- ++(-\ang:\griddvlen);%
    }%
    \pgfmathsetmacro{\gridjj}{\vv-1}%
    \pgfmathsetmacro{\griddhlen}{\hh*\dlen}%
    \foreach \gj in {1,...,\gridjj} {%
      \draw[lightgray,very thin] (0,\gj*\vlen) -- ++(\ang:\griddhlen);%
      \draw[lightgray,very thin] (0,\gj*\vlen) -- ++(-\ang:\griddhlen);%
    }%
  \end{scope}%
  \draw[lightgray,very thin] rectangle (\xmax,\ymax);%
  \fi%
}%
\newcommand{\gn}[4]{%
  \ifnum#4=1%
    \node[circle,draw=black,line width=0.9pt,fill=gray!65,inner sep=0pt,minimum size=22pt,text width=16pt,align=center,font=\tiny] at (#1*\hlen,#2*\vlen) {#3};%
  \else%
    \node[circle,draw=gray,fill=gray!10,inner sep=0pt,minimum size=22pt,text width=16pt,align=center,font=\tiny] at (#1*\hlen,#2*\vlen) {#3};%
  \fi%
}%
\newcommand{\gnref}[4]{%
  \gn{#1}{#2}{#3}{0}%
  \node[circle,draw=gray,fill=white,inner sep=0.4pt,font=\fontsize{4}{4}\selectfont\bfseries,xshift=5pt,yshift=4pt] at (#1*\hlen,#2*\vlen) {#4};%
}%
