<?xml version="1.0" encoding="UTF-8"?>
<section xml:id="sec-C-melodic-minor-scale-shape" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>C Melodic Minor Scale Shape Ascending</title>
  <introduction>
    <p>Use this shape to form other melodic minor scales where the shape fits, ie; starting from the same column or using the same pattern in different positions. Scale name will be given by the first note of the scale.</p>
  </introduction>

  <subsection xml:id="subsec-C-melodic-minor-scale-shape-layout">
    <title>Basic C Melodic Minor Shape</title>

    <figure xml:id="fig-C-melodic-minor-scale-shape">
      <caption>Basic C melodic minor shape. Ascending fingering numbers appear at the top of each button and descending fingering numbers at the bottom.</caption>
      <image xml:id="img-C-melodic-minor-scale-shape">
        <latex-image>
\begin{tikzpicture}[scale=0.85, transform shape]
\newif\ifisoGridLines
<!--\isoGridLinestrue % Default: show grid lines. To hide, use--> \isoGridLinesfalse <!--before the figure.-->

% User-adjustable parameters
\pgfmathsetmacro{\isoangle}{60}
\pgfmathsetmacro{\vv}{16}
\pgfmathsetmacro{\hh}{8}
\pgfmathsetmacro{\vlen}{1.4}

% Isometric setup
\pgfmathsetmacro{\ang}{\isoangle/2}
\pgfmathsetmacro{\dlen}{(\vlen/2) / sin(\ang)}
\pgfmathsetmacro{\hlen}{(\vlen/2) / tan(\ang)}
\pgfmathsetmacro{\xmax}{\hh*\hlen}
\pgfmathsetmacro{\ymax}{\vv*\vlen}
\pgfmathsetmacro{\xoffset}{\xmax + 0.9}
\pgfmathsetmacro{\leftshift}{0.3}
\pgfmathsetmacro{\rightshift}{\leftshift + \xoffset}
\pgfmathsetmacro{\bellowscenter}{\leftshift + \xmax + 0.08}
\pgfmathsetmacro{\bellowsspacing}{0.18}

\newcommand{\drawisogrid}{
  \ifisoGridLines
    \begin{scope}
      \path[clip] (0,0) rectangle (\xmax,\ymax);

      \pgfmathsetmacro{\ii}{\hh-1}
      \foreach \i in {1,...,\ii} {
        \draw[lightgray,very thin] (\i*\hlen,0) -- ++(0,\ymax);
      }

      \pgfmathsetmacro{\dvlen}{2*\vv*\dlen}
      \foreach \i in {0,2,...,\hh} {
        \draw[lightgray,very thin] (\i*\hlen,0) -- ++(\ang:\dvlen);
        \draw[lightgray,very thin] (\i*\hlen,\ymax) -- ++(-\ang:\dvlen);
      }

      \pgfmathsetmacro{\jj}{\vv-1}
      \pgfmathsetmacro{\dhlen}{\hh*\dlen}
      \foreach \j in {1,...,\jj} {
        \draw[lightgray,very thin] (0,\j*\vlen) -- ++(\ang:\dhlen);
        \draw[lightgray,very thin] (0,\j*\vlen) -- ++(-\ang:\dhlen);
      }
    \end{scope}
  \fi
}

\csname tikzset\endcsname{
  nodestyle1/.style={circle, draw=gray, fill=gray!10, inner sep=1pt, minimum size=36pt},
  nodestyle2/.style={circle, draw=gray, fill=gray!40, inner sep=1pt, minimum size=36pt},
  nodestyle3/.style={circle, draw=gray, fill=gray!10, inner sep=1pt, minimum size=36pt},
  nodestyle4/.style={circle, draw=gray, fill=gray!40, inner sep=1pt, minimum size=36pt},
}

\newcommand{\templatenode}[3]{
  \node[nodestyle1] at (#1*\hlen,#2*\vlen) {#3};
}

\newcommand{\templatenodestyle}[4]{
  \node[nodestyle#4] at (#1*\hlen,#2*\vlen) {#3};
}

\newcommand{\templatesplitnodestyle}[6]{
  \node[nodestyle#6] at (#1*\hlen,#2*\vlen) {};
  \node[font=\bfseries\small] at (#1*\hlen,#2*\vlen) {#3};
  \node[font=\bfseries\scriptsize] at (#1*\hlen-0.23,#2*\vlen+0.23) {#4};
}

\newcommand{\templatesplitnodestylebass}[6]{
  \node[nodestyle#6] at (#1*\hlen,#2*\vlen) {};
  \node[font=\bfseries\small] at (#1*\hlen,#2*\vlen) {#3};
  \node[font=\bfseries\scriptsize] at (#1*\hlen-0.25,#2*\vlen+0.24) {#4};
  \node[font=\bfseries\scriptsize] at (#1*\hlen+0.25,#2*\vlen-0.24) {#5};
}

\begin{scope}[xshift=\leftshift cm]
  \drawisogrid

  \node[anchor=west, font=\bfseries\small] at (0.35*\hlen,12.6*\vlen) {Bass Hand (LH)};

    \csname templatesplitnodestylebass\endcsname{1}{1.5}{C}{2}{}{2}
    \csname templatenodestyle\endcsname{2}{2.0}{}{3}
    \csname templatesplitnodestylebass\endcsname{3}{2.5}{D}{3}{}{2}
    \csname templatenodestyle\endcsname{4}{3.0}{}{3}
    \csname templatenodestyle\endcsname{5}{3.5}{}{3}
    \csname templatenodestyle\endcsname{6}{4.0}{}{3}

    \csname templatesplitnodestylebass\endcsname{1}{2.5}{E$\flat$}{2}{}{2}
    \csname templatenodestyle\endcsname{2}{3.0}{}{3}
    \csname templatesplitnodestylebass\endcsname{3}{3.5}{F}{3}{}{2}
    \csname templatenodestyle\endcsname{4}{4.0}{}{3}
    \csname templatenodestyle\endcsname{5}{4.5}{}{3}
    \csname templatenodestyle\endcsname{6}{5.0}{}{3}

    \csname templatenodestyle\endcsname{1}{3.5}{}{3}
    \csname templatesplitnodestylebass\endcsname{2}{4.0}{G}{4}{}{2}
    \csname templatenodestyle\endcsname{3}{4.5}{}{3}
    \csname templatenodestyle\endcsname{4}{5.0}{}{3}
    \csname templatenodestyle\endcsname{5}{5.5}{}{3}
    \csname templatenodestyle\endcsname{6}{6.0}{}{3}

    \csname templatesplitnodestylebass\endcsname{1}{4.5}{A}{2}{}{2}
    \csname templatenodestyle\endcsname{2}{5.0}{}{3}
    \csname templatesplitnodestylebass\endcsname{3}{5.5}{B}{3}{}{2}
    \csname templatenodestyle\endcsname{4}{6.0}{}{3}
    \csname templatenodestyle\endcsname{5}{6.5}{}{3}
    \csname templatenodestyle\endcsname{6}{7.0}{}{3}

    \csname templatesplitnodestylebass\endcsname{1}{5.5}{C}{4}{}{2}
    \csname templatenodestyle\endcsname{2}{6.0}{}{3}
    \csname templatesplitnodestylebass\endcsname{3}{6.5}{D}{}{}{2}
    \csname templatenodestyle\endcsname{4}{7.0}{}{3}
    \csname templatenodestyle\endcsname{5}{7.5}{}{3}
    \csname templatenodestyle\endcsname{6}{8.0}{}{3}

    \csname templatesplitnodestylebass\endcsname{1}{6.5}{E$\flat$}{}{}{2}
    \csname templatenodestyle\endcsname{2}{7.0}{}{3}
    \csname templatesplitnodestylebass\endcsname{3}{7.5}{F}{}{}{2}
    \csname templatenodestyle\endcsname{4}{8.0}{}{3}
    \csname templatenodestyle\endcsname{5}{8.5}{}{3}
    \csname templatenodestyle\endcsname{6}{9.0}{}{3}

    \csname templatenodestyle\endcsname{1}{7.5}{}{3}
    \csname templatesplitnodestylebass\endcsname{2}{8.0}{G}{}{}{2}
    \csname templatenodestyle\endcsname{3}{8.5}{}{3}
    \csname templatenodestyle\endcsname{4}{9.0}{}{3}
    \csname templatenodestyle\endcsname{5}{9.5}{}{3}
    \csname templatenodestyle\endcsname{6}{10.0}{}{3}

    \csname templatesplitnodestylebass\endcsname{1}{8.5}{A}{}{}{2}
    \csname templatenodestyle\endcsname{2}{9.0}{}{3}
    \csname templatesplitnodestylebass\endcsname{3}{9.5}{B}{}{}{2}
    \csname templatenodestyle\endcsname{4}{10.0}{}{3}
    \csname templatenodestyle\endcsname{5}{10.5}{}{3}
    \csname templatenodestyle\endcsname{6}{11.0}{}{3}

    \csname templatesplitnodestylebass\endcsname{1}{9.5}{C}{}{}{2}
    \csname templatenodestyle\endcsname{2}{10.0}{}{3}
    \csname templatesplitnodestylebass\endcsname{3}{10.5}{D}{}{}{2}
    \csname templatenodestyle\endcsname{4}{11.0}{}{3}
    \csname templatenodestyle\endcsname{5}{11.5}{}{3}
    \csname templatenodestyle\endcsname{6}{12.0}{}{3}

  \node[anchor=north, rotate=90, font=\bfseries\scriptsize] at (5*\hlen,2.2*\vlen) {Bass};
  \node[anchor=north, rotate=90, font=\bfseries\scriptsize] at (6*\hlen,2.2*\vlen) {Counter Bass};
\end{scope}

\foreach \x in {\bellowscenter-\bellowsspacing,\bellowscenter,\bellowscenter+\bellowsspacing} {
  \draw[gray,thin] (\x,3.5*\vlen) -- (\x,11.5*\vlen);
}
\node[font=\bfseries\scriptsize] at (\bellowscenter,12.6*\vlen) {Lap};
\node[font=\bfseries\scriptsize] at (\bellowscenter,2.2*\vlen) {Bellows};
\node[font=\bfseries\scriptsize] at (\bellowscenter,1.0*\vlen) {Chin};

\begin{scope}[xshift=\rightshift cm]
  \drawisogrid

  \node[anchor=east, font=\bfseries\small] at (5.65*\hlen,12.6*\vlen) {Treble Hand (RH)};

    \csname templatesplitnodestyle\endcsname{5}{1.5}{C}{1}{4}{2}
    \csname templatenodestyle\endcsname{4}{2.0}{}{3}
    \csname templatesplitnodestyle\endcsname{3}{2.5}{D}{3}{3}{2}
    \csname templatenodestyle\endcsname{2}{3.0}{}{3}
    \csname templatenodestyle\endcsname{1}{3.5}{}{3}

    \csname templatesplitnodestyle\endcsname{5}{2.5}{E$\flat$}{4}{1}{2}
    \csname templatenodestyle\endcsname{4}{3.0}{}{3}
    \csname templatesplitnodestyle\endcsname{3}{3.5}{F}{2}{4}{2}
    \csname templatenodestyle\endcsname{2}{4.0}{}{3}
    \csname templatenodestyle\endcsname{1}{4.5}{}{3}

    \csname templatenodestyle\endcsname{5}{3.5}{}{3}
    \csname templatesplitnodestyle\endcsname{4}{4.0}{G}{3}{3}{2}
    \csname templatenodestyle\endcsname{3}{4.5}{}{3}
    \csname templatenodestyle\endcsname{2}{5.0}{}{3}
    \csname templatenodestyle\endcsname{1}{5.5}{}{3}

    \csname templatesplitnodestyle\endcsname{5}{4.5}{A}{4}{1}{2}
    \csname templatenodestyle\endcsname{4}{5.0}{}{3}
    \csname templatesplitnodestyle\endcsname{3}{5.5}{B}{3}{2}{2}
    \csname templatenodestyle\endcsname{2}{6.0}{}{3}
    \csname templatenodestyle\endcsname{1}{6.5}{}{3}

    \csname templatesplitnodestyle\endcsname{5}{5.5}{C}{1}{1}{2}
    \csname templatenodestyle\endcsname{4}{6.0}{}{3}
    \csname templatesplitnodestyle\endcsname{3}{6.5}{D}{3}{3}{2}
    \csname templatenodestyle\endcsname{2}{7.0}{}{3}
    \csname templatenodestyle\endcsname{1}{7.5}{}{3}

    \csname templatesplitnodestyle\endcsname{5}{6.5}{E$\flat$}{4}{1}{2}
    \csname templatenodestyle\endcsname{4}{7.0}{}{3}
    \csname templatesplitnodestyle\endcsname{3}{7.5}{F}{2}{4}{2}
    \csname templatenodestyle\endcsname{2}{8.0}{}{3}
    \csname templatenodestyle\endcsname{1}{8.5}{}{3}

    \csname templatenodestyle\endcsname{5}{7.5}{}{3}
    \csname templatesplitnodestyle\endcsname{4}{8.0}{G}{3}{3}{2}
    \csname templatenodestyle\endcsname{3}{8.5}{}{3}
    \csname templatenodestyle\endcsname{2}{9.0}{}{3}
    \csname templatenodestyle\endcsname{1}{9.5}{}{3}

    \csname templatesplitnodestyle\endcsname{5}{8.5}{A}{4}{1}{2}
    \csname templatenodestyle\endcsname{4}{9.0}{}{3}
    \csname templatesplitnodestyle\endcsname{3}{9.5}{B}{3}{2}{2}
    \csname templatenodestyle\endcsname{2}{10.0}{}{3}
    \csname templatenodestyle\endcsname{1}{10.5}{}{3}

    \csname templatesplitnodestyle\endcsname{5}{9.5}{C}{4}{1}{2}
    \csname templatenodestyle\endcsname{4}{10.0}{}{3}
    \csname templatenodestyle\endcsname{3}{10.5}{D}{2}
    \csname templatenodestyle\endcsname{2}{11.0}{}{3}
    \csname templatenodestyle\endcsname{1}{11.5}{}{3}
\end{scope}

\end{tikzpicture}
        </latex-image>
      </image>
    </figure>

    <figure xml:id="fig-C-melodic-minor-scale-shape-notation">
      <caption>C melodic minor scale notation: bass-hand shape (left) and two-octave treble-hand run (right).</caption>
      <sidebyside widths="45% 4% 45%" margins="2%">
        <image xml:id="img-C-melodic-minor-scale-shape-lh-notation" source="notation/c-melodic-minor-bass-shape" width="100%" />
        <p></p>
        <image xml:id="img-C-melodic-minor-scale-shape-rh-notation" source="notation/c-melodic-minor-two-octave" width="100%" />
      </sidebyside>
    </figure>
  </subsection>
</section>
