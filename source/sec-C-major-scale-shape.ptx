    \csname templatenodestyle\endcsname{5}{6.5}{}{3}
    \csname templatesplitnodestyle\endcsname{4}{7.0}{E}{4}{1}{2}
    \csname templatesplitnodestyle\endcsname{3}{7.5}{F}{2}{3}{2}
    \csname templatenodestyle\endcsname{2}{8.0}{}{3}
    \csname templatenodestyle\endcsname{1}{8.5}{}{3}

    \csname templatenodestyle\endcsname{5}{7.5}{}{3}
