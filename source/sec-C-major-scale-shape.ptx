    \csname templatesplitnodestyle\endcsname{5}{8.5}{A}{4}{1}{2}
    \csname templatenodestyle\endcsname{4}{9.0}{}{3}
    \csname templatesplitnodestyle\endcsname{3}{9.5}{B}{3}{3}{2}
    \csname templatenodestyle\endcsname{2}{10.0}{}{3}
